# Copy to .env.local and fill in. Never commit .env.local.
# Find these in Supabase: Project Settings -> Data API / API Keys

SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable key (sb_publishable_...). Safe for client use, though this app
# never calls Supabase from the browser.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_..., labelled service_role on older dashboards).
# Server and collector only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=

# Local only. "1" shows a "Collect now" button that runs the collector from the
# dashboard (a Chrome window opens while it runs). Ignored on Vercel; leave
# unset on any shared or hosted deployment.
ENABLE_UI_COLLECTION=

# Deployed "Collect now": runs the collector on GitHub Actions. Create a
# fine-grained token for this repository only, permission Actions: Read and
# write. Set both on Vercel; leave empty locally to use ENABLE_UI_COLLECTION.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=owner/repo-name

# Optional. SearchApi (searchapi.io) key: when the browser collector fails for a
# property, its newest reviews are fetched through SearchApi instead (paid, 10
# reviews per credit). Leave empty to disable the fallback.
SEARCHAPI_API_KEY=
